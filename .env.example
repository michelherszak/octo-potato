# Copy to .dev.vars for local development. Never commit real values.
PUBLISH_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
SITE_URL=http://localhost:5180
SITE_INDEXABLE=false
ADMIN_EMAILS=admin@example.com

# Reader accounts and company updates (runtime secrets; never browser variables).
ACCOUNT_SECRET=
RESEND_API_KEY=
EMAIL_FROM=TechThese <neu@updates.techthese.de>
EMAIL_DAILY_LIMIT=100
EMAIL_SIGNUP_ENABLED=false
EMAIL_UPDATES_ENABLED=false

# Supabase sign-in (identity). The publishable key is delivered to the browser by design.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-with-the-browser-safe-publishable-key
# Server-only. Required for complete account deletion; never expose this value to browser code.
SUPABASE_SERVICE_ROLE_KEY=replace-with-the-server-only-service-role-key
